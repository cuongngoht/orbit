# Every text file is checked out with LF line ends, on Windows too (0.0.2): a SKILL.md's frontmatter, a JSON fixture, a
# shell shim and a journal line are read byte for byte, and a checkout that turned them into CRLF was a different
# plugin from the one the gates held to. The rules below this one say which bytes are kept exactly as committed.
* text=auto eol=lf

# A fixture is a capture: its bytes are what a program printed (a runner's CRLF included), checked out as committed.
/test/fixtures/** -text

# integrations/ holds what another program installs (1.8.5: the VS Code companion, an extension a person adds to
# VS Code), never part of this plugin's archive.
/integrations/** export-ignore

# acceptance/ (0.1.0) is the native acceptance harness and its example projects: run by a person or a CI job, never
# shipped, and kept outside test/ because `node --test` runs every module under test/.
/acceptance/** export-ignore

# benchmark/ is the Docker benchmark of Orbit's own source (its controller, images, packs and hidden checks): run by a
# person on a development machine, never shipped. It sits beside acceptance/ rather than inside it, so adding a case
# never changes the source the backend acceptance record is keyed to.
/benchmark/** export-ignore

# Bytes that are PINNED must be checked out as they were committed: the report's
# vendored chart library, fonts and licences are hashed in their VENDOR.json and
# checked by the suite, and a CRLF checkout would change every hash.
/skills/orbit-report/assets/vendor/** -text
