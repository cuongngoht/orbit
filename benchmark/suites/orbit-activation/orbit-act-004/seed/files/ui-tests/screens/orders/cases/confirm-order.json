{
  "id": "confirm-order",
  "name": "Confirm an open order",
  "start": "orders",
  "steps": [
    { "do": "goto", "screen": "orders", "wait": "document.body.innerText.length>0" },
    { "do": "click", "on": "orders/Confirm", "wait": "location.pathname.endsWith('/confirm')" },
    { "do": "click", "on": "order-confirmation/Place order", "wait": "document.body.innerText.includes('confirmed')" },
    { "do": "report", "js": "JSON.stringify({state: document.querySelector('.state')?.textContent})", "expct": "it.state === 'confirmed'" }
  ],
  "seen": "src"
}
