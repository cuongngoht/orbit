{
  "schema": 1,
  "id": "seed",
  "about": "the workflow a person started for ORD-12 and left after its context, tracked under that reference",
  "steps": [
    {
      "do": "orbit",
      "argv": [
        "track.mjs",
        "track",
        "Implement the refund approval rule for ORD-12",
        "--ref=ORD-12",
        "--mode=autonomous"
      ]
    },
    {
      "do": "orbit",
      "argv": [
        "automation.mjs",
        "start",
        "--for=Implement the refund approval rule for ORD-12 (docs/refunds.md)",
        "--intent=development"
      ],
      "keep": {
        "workflow": "task"
      }
    },
    {
      "do": "orbit",
      "argv": [
        "track.mjs",
        "list"
      ],
      "keep": {
        "work": "works.0.work"
      }
    },
    {
      "do": "orbit",
      "argv": [
        "track.mjs",
        "link",
        "{work}",
        "--workflow={workflow}"
      ],
      "mayFail": true
    },
    {
      "do": "orbit",
      "argv": [
        "automation.mjs",
        "context",
        "{workflow}"
      ],
      "keep": {
        "revision": "revision"
      }
    }
  ]
}
