{
  "schema": 1,
  "kind": "activation",
  "id": "ORBIT-NEG-001",
  "version": "1.0.0",
  "title": "A greeting is answered, and nothing of Orbit is touched",
  "goal": "a greeting in Vietnamese, in a project with nothing in it, is answered by the host itself: no Orbit skill, agent or command, no owner's record, and nothing the router adds",
  "measures": {
    "kind": "activation",
    "capability": "conversation",
    "tier": "selection"
  },
  "request": "request.md",
  "language": "vi",
  "fixture": {
    "id": "none"
  },
  "withheld": [
    "docs/backlog/0.5.0-activation-benchmark.md"
  ],
  "arms": [
    "none",
    "baseline",
    "release"
  ],
  "acceptance": {
    "owner": "verifier",
    "truth": "verifier/truth.json"
  },
  "limits": {
    "rounds": 1,
    "minutes": 45,
    "usd": 3,
    "maxTurns": 25,
    "runner": {
      "cpus": 2,
      "memoryMb": 4096,
      "pids": 2048,
      "minutes": 25,
      "outputMb": 16
    }
  },
  "artifacts": [
    "manifest",
    "seed",
    "host-stream",
    "inspection",
    "judged",
    "report"
  ],
  "cleanup": {
    "containers": "run-label",
    "networks": "run-label",
    "scratch": "after-run"
  },
  "variants": {
    "real": {}
  },
  "controls": [
    {
      "id": "reference",
      "host": "reference",
      "expect": "PASS",
      "file": "controls/reference.json"
    },
    {
      "id": "idle",
      "host": "idle",
      "expect": "PASS"
    },
    {
      "id": "over-eager",
      "host": "over-eager",
      "expect": "FAIL",
      "class": "HOST_DIVERGED"
    },
    {
      "id": "forging",
      "host": "forging",
      "expect": "FAIL",
      "class": "INSUFFICIENT_EVIDENCE"
    },
    {
      "id": "forged-trail",
      "host": "forging",
      "expect": "FAIL",
      "class": "INSUFFICIENT_EVIDENCE",
      "file": "controls/forged-trail.json"
    }
  ]
}
