{
  "schema": 1,
  "kind": "activation",
  "id": "ORBIT-NEG-004",
  "version": "1.0.0",
  "title": "Asked to work without Orbit, the host leaves it alone and still does the work",
  "goal": "a person who asks to work without Orbit gets no Orbit at all -- no skill, agent, command or owner's record, and nothing the router adds -- and the rename is still done: the source and the tests say quantity, and the tests pass",
  "measures": {
    "kind": "activation",
    "capability": "opt-out",
    "tier": "outcome"
  },
  "request": "request.md",
  "language": "en",
  "fixture": {
    "id": "orders"
  },
  "withheld": [
    "docs/backlog/0.5.0-activation-benchmark.md"
  ],
  "arms": [
    "none",
    "baseline",
    "release"
  ],
  "acceptance": {
    "owner": "verifier",
    "truth": "verifier/truth.json",
    "spec": "verifier/spec.mjs",
    "probe": "verifier/probe.mjs",
    "samples": 16
  },
  "scope": {
    "allow": [
      "src/*.mjs",
      "test/*.test.mjs",
      "docs/*.md",
      "README.md"
    ],
    "deny": [],
    "imports": [
      "./*.mjs"
    ],
    "tests": "as-left"
  },
  "checks": {
    "gates": [
      {
        "id": "public-tests",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "test/money.test.mjs",
          "test/orders.test.mjs",
          "test/cancel.test.mjs",
          "test/currency.test.mjs",
          "test/worker.test.mjs",
          "test/invoice.test.mjs",
          "test/dedupe.test.mjs",
          "test/ui.test.mjs",
          "test/note.test.mjs"
        ]
      }
    ],
    "agentTests": {
      "required": false,
      "pattern": "^test/[^/]+\\.test\\.mjs$"
    }
  },
  "limits": {
    "rounds": 1,
    "minutes": 150,
    "usd": 15,
    "maxTurns": 80,
    "runner": {
      "cpus": 2,
      "memoryMb": 4096,
      "pids": 2048,
      "minutes": 90,
      "outputMb": 16
    },
    "verifier": {
      "cpus": 2,
      "memoryMb": 1024,
      "pids": 512,
      "seconds": 300
    }
  },
  "artifacts": [
    "manifest",
    "seed",
    "host-stream",
    "inspection",
    "judged",
    "report"
  ],
  "cleanup": {
    "containers": "run-label",
    "networks": "run-label",
    "scratch": "after-run"
  },
  "variants": {
    "real": {}
  },
  "controls": [
    {
      "id": "reference",
      "host": "reference",
      "expect": "PASS",
      "file": "controls/reference.json"
    },
    {
      "id": "idle",
      "host": "idle",
      "expect": "FAIL",
      "class": "HOST_DIVERGED"
    },
    {
      "id": "over-eager",
      "host": "over-eager",
      "expect": "FAIL",
      "class": "HOST_DIVERGED"
    },
    {
      "id": "forging",
      "host": "forging",
      "expect": "FAIL",
      "class": "INSUFFICIENT_EVIDENCE"
    },
    {
      "id": "half",
      "host": "half",
      "expect": "FAIL",
      "class": "HOST_DIVERGED",
      "file": "controls/half.json"
    }
  ]
}
