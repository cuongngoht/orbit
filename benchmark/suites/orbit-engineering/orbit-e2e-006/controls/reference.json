  "about": "A reference solution of the goal with a regression test that fails before it and passes after, made by the scripted host in the engineering task's own workspace. Kept only to prove the verifier and Orbit's goal path CAN pass this case; it is never handed to a coding host.",
  "mutations": [
    {
      "id": "keep",
      "file": "src/orders.mjs",
      "find": "currency: input.currency ?? \"USD\", ",
      "replace": "currency: input.currency ?? \"USD\", note: String(input.note ?? \"\"), ",
      "count": 1
    },
    {
      "id": "note-of",
      "file": "src/ui.mjs",
      "find": "export const renderOrder",
      "replace": "const noteOf = (order) => (order.note ? [`  <p class=\"note\">${escaped(order.note)}</p>`] : []);\n\nexport const renderOrder",
      "count": 1
    },
    {
      "id": "draw",
      "file": "src/ui.mjs",
