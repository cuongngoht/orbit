  "files": [
    {
      "rel": "test/order-note.test.mjs",
      "lines": [
        "import assert from \"node:assert/strict\";",
        "import { mkdtempSync, rmSync } from \"node:fs\";",
        "import { tmpdir } from \"node:os\";",
        "import { join } from \"node:path\";",
        "import { test } from \"node:test\";",
        "import { handle } from \"../src/api.mjs\";",
        "import { openStore } from \"../src/store.mjs\";",
        "import { renderOrder } from \"../src/ui.mjs\";",
        "",
        "function fresh(t) {",
        "  const dir = mkdtempSync(join(tmpdir(), \"orders-\"));",
        "  t.after(() => rmSync(dir, { recursive: true, force: true }));",
        "  return dir;",
        "}",
        "",
        "test(\"an order keeps its note across a restart and the view draws it escaped\", (t) => {",
        "  const dir = fresh(t);",
        "  const id = handle(openStore(dir), { method: \"POST\", path: \"/orders\", body: { lines: [{ qty: 1, unitMinor: 100 }], note: \"ring twice & wait\" } }).body.id;",
        "  const order = handle(openStore(dir), { method: \"GET\", path: `/orders/${id}` }).body;",
        "  assert.equal(order.note, \"ring twice & wait\");",
        "  assert.match(renderOrder(order), /<p class=\"note\">ring twice &amp; wait<\\/p>/);",
        "});"
      ]
    }
  ],
  "deletes": []
}
