{
  "schema": 1,
  "kind": "engineering",
  "id": "ORBIT-E2E-007",
  "version": "1.0.0",
  "baseline": "FAIL",
  "fixture": "orders",
  "title": "A payment's invoice is durable before its ack, carried through an interrupted session",
  "goal": "the reliability fix of ORBIT-E2E-004 with the first round cut off mid-work, the way a crash stops a session: the next round resumes the same goal and engineering task, reconciles what did not settle -- never sending an action again, never starting a second task -- and takes the change to verified",
  "measures": {
    "kind": "engineering",
    "capability": "engineering.goal.resume",
    "expects": "change"
  },
  "subject": {
    "paths": [
      "src/worker.mjs",
      "src/orders.mjs",
      "src/store.mjs"
    ],
    "exports": {
      "src/worker.mjs": [
        "consume"
      ],
      "src/orders.mjs": [
        "createOrder"
      ],
      "src/store.mjs": [
        "openStore"
      ]
    }
  },
  "request": "request.md",
  "reproduce": "every failing check names the requests or messages it sent, in order, the behaviour the goal asks for and what came back; the probe runs the target's own modules in its own process, over a store of its own under the container's /tmp",
  "acceptance": {
    "owner": "verifier",
    "spec": "verifier/spec.mjs",
    "probe": "verifier/probe.mjs",
    "samples": 48
  },
  "scope": {
    "allow": [
      "src/*.mjs",
      "test/*.test.mjs"
    ],
    "deny": [],
    "imports": [
      "./*.mjs"
    ]
  },
  "checks": {
    "gates": [
      {
        "id": "public-tests",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "test/money.test.mjs",
          "test/orders.test.mjs",
          "test/cancel.test.mjs",
          "test/currency.test.mjs",
          "test/worker.test.mjs",
          "test/ui.test.mjs",
          "test/note.test.mjs"
        ]
      }
    ],
    "agentTests": {
      "required": true,
      "pattern": "^test/[^/]+\\.test\\.mjs$"
    }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 15,
    "runner": {
      "cpus": 2,
      "memoryMb": 4096,
      "pids": 2048,
      "minutes": 90,
      "outputMb": 16
    },
    "verifier": {
      "cpus": 2,
      "memoryMb": 1024,
      "pids": 512,
      "seconds": 300
    },
    "engineering": {
      "attempts": 6,
      "actions": 120
    }
  },
  "artifacts": [
    "manifest",
    "baseline",
    "candidate-patch",
    "verification",
    "host-result",
    "report"
  ],
  "cleanup": {
    "containers": "run-label",
    "networks": "run-label",
    "scratch": "after-run"
  },
  "variants": {
    "real": {
      "mutations": "variants/real.json"
    },
    "solved": {}
  },
  "controls": [
    {
      "id": "solved",
      "variant": "solved",
      "expect": "PASS"
    },
    {
      "id": "real",
      "variant": "real",
      "expect": "FAIL"
    }
  ],
  "repairs": [
    {
      "id": "interrupted",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "PASS",
      "script": "interrupt"
    },
    {
      "id": "idle",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "NO_PROGRESS",
      "script": "idle"
    }
  ],
  "interrupt": {
    "round": 1,
    "afterMinutes": 4
  }
}
