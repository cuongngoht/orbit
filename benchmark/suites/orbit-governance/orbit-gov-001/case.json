{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-GOV-001",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "Autonomous by default: an action stops for a person only at one of five protected boundaries",
  "goal": "authorize() answers AUTO for every action that crosses no protected boundary -- ordinary development, a kind nobody has seen, nothing described -- and otherwise names exactly the boundary the action meets: a primary checkout write is a person's DENY, every push is APPROVE_ONCE, a production deployment or migration is APPROVE_ONCE, and destructive production data, a production write nobody declared the meaning of included, is APPROVE_ONCE_DESTRUCTIVE; what nobody declared production is never production, and nothing riding on an action moves its verdict",
  "measures": { "kind": "correctness", "capability": "protected.authorize", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/protected/authorize.mjs", "src/protected/boundaries.mjs"],
    "exports": { "src/protected/authorize.mjs": ["authorize"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the action it described, the verdict the contract expects and the one that came back; the probe imports the subject's own authorize and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/protected/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "protected-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/protected-boundaries.test.mjs", "test/protected-bypass.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/protected", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
