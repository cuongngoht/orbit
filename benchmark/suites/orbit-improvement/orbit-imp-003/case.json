{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-IMP-003",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "Twelve promotion gates in order, and a reported run never proves",
  "goal": "gatesOf() asks all twelve promotion gates every time, in the contract's order, and decisionOf() lets the first that does not hold decide what happens instead -- reject, supersede, wait, block, await or stale -- where a candidate run proves only when the engine bound it or the host observed it (a reported, unattributed or conflicting run never does), a person's disable, archive or revocation of the version in place always blocks, and a person's door passes the policy gate and no other",
  "measures": { "kind": "correctness", "capability": "improvement.promotion-gates", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/improvement/gates.mjs"],
    "exports": { "src/improvement/gates.mjs": ["gatesOf", "decisionOf"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the facts the gates were asked about -- the candidate, its evaluations, its runs and their attribution, the version in place, the door and the settings -- what the contract expects and what came back; the probe imports the subject's own module and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/improvement/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "improvement-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/improvement-core.test.mjs", "test/improvement-regression.test.mjs", "test/improvement-satellite.test.mjs", "test/improvement-manipulation.test.mjs", "test/improvement-boundary.test.mjs", "test/skill-workflow.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/improvement", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
