{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-MEM-001",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "One session is one machine on one UTC day, and a named session is counted by its name",
  "goal": "dayOf(), sessionId() and independent() count one session per machine and UTC day -- three runs in one sitting are one session, another day (even across midnight) or another machine is another -- and knownIn() over the marks sessionMarks() leaves tells an observation already counted from a new one: two named observations by their names, two unnamed ones by machine and day, and a named and an unnamed one on the same machine and day never independent, whichever came first",
  "measures": { "kind": "correctness", "capability": "memory.session", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/memory/session.mjs"],
    "exports": { "src/memory/session.mjs": ["sessionId", "independent", "sessionMarks", "knownIn", "dayOf"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the runs or observations it compared, what the contract expects and what came back; the probe imports the subject's own session module and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/memory/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "memory-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/support.test.mjs", "test/engineering-reconcile.test.mjs", "test/improvement-core.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/memory", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
