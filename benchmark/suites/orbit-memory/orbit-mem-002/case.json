{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-MEM-002",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "A, B, A is two sessions, and a contradiction keeps a record possible",
  "goal": "counted() keeps a record's supporting and contradicting sessions as sets of session marks -- a session already counted in its list adds nothing, so a rerun is one session and A, B, A is two and never three, and a named and an unnamed observation on one machine and day are one -- and derive() calls a record certain exactly when two or more independent sessions support it and none contradicts it",
  "measures": { "kind": "correctness", "capability": "memory.support", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/memory/support.mjs"],
    "exports": { "src/memory/support.mjs": ["counted", "derive"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the sequence of observations it folded, what the contract expects and what came back; the probe imports the subject's own support module and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/memory/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "support-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/support.test.mjs", "test/engineering-reconcile.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/memory", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
