{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-MEM-003",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "A lesson counts sessions, never runs, and one session is an observation",
  "goal": "failures() groups a ledger's failures on the step it records (BLOCKED apart from FAIL) and counts the independent sessions behind each, and the sessions that passed after the last failure, never the runs; gradeOf() and worthKeeping() then keep a lesson only from two or more sessions -- one session is an observation, printed and not kept -- demote a contradicted one, reject and keep one contradicted at least as often as it is supported, and call two sessions on a moved frontend stale",
  "measures": { "kind": "correctness", "capability": "learn.lessons", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/learn/families/failures.mjs", "src/learn/families/shared.mjs", "src/learn/confidence.mjs"],
    "exports": { "src/learn/families/failures.mjs": ["failures"], "src/learn/confidence.mjs": ["gradeOf", "worthKeeping"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the ledger of runs it analysed, what the contract expects and what came back; the probe imports the subject's own failures family and confidence ladder and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/learn/*.mjs", "src/learn/families/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "learn-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/learn-lesson.test.mjs", "test/learn-families.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/learn", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
