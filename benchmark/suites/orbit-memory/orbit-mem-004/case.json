{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-MEM-004",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "Authority is derived, and a host's memory is never above host-memory",
  "goal": "authorityOf() derives how far a knowledge claim may be relied on from what the claim already says -- rule, adopted, source, confirmed, host-memory, inference, first match wins -- never from a tier it carries; freshness is the one measured now, so a moved scope drops a claim from source; and a host's memory stays at host-memory whatever confidence it claims",
  "measures": { "kind": "correctness", "capability": "knowledge.authority", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/knowledge/vocab.mjs"],
    "exports": { "src/knowledge/vocab.mjs": ["authorityOf"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the claim it graded, what the contract expects and what came back; the probe imports the subject's own knowledge vocabulary and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/knowledge/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "knowledge-vocab", "argv": ["node", "--test", "--test-reporter=tap", "test/knowledge-vocab.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/knowledge", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
