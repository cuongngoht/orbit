{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-MEM-009",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "A knowledge recall measures freshness once, now, and reads no file",
  "goal": "knowledge claims answers from what is recorded: it measures each claim's freshness now, in one look at the index however many claims it answers, reads no file, lists nothing, searches nothing and writes nothing; a claim is as fresh as its own scope -- stale once a commit moved it, and on every recall after, unknown while an edit under it is uncommitted -- and a note no claim watches moves nothing",
  "measures": { "kind": "capability", "capability": "memory.knowledge-recall", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/knowledge/views/claims.mjs", "src/knowledge/ingest.mjs", "src/knowledge/store.mjs", "src/extensions/knowledge-parts.mjs", "src/frontend/composite.mjs", "src/store/io.mjs"],
    "exports": { "src/knowledge/views/claims.mjs": ["claims"], "src/knowledge/ingest.mjs": ["ingest"], "src/knowledge/store.mjs": ["createKnowledge"], "src/extensions/knowledge-parts.mjs": ["createKnowledgeParts"], "src/frontend/composite.mjs": ["createSourceTree"], "src/store/io.mjs": ["realIo"] }
  },
  "prepare": { "requires": ["node", "git"] },
  "request": "request.md",
  "reproduce": "every failing check names the checkout, the claims recorded about it and the plan of recalls and changes it played, what the contract expects of each recall and what came back; the probe records the claims through the subject's own ingest, recalls them through its own claims view, counts every git call a recall makes, and keeps each recall's time, calls and reads as the check's evidence",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 24 },
  "scope": { "allow": ["src/knowledge/*.mjs", "src/knowledge/views/*.mjs", "src/freshness.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "knowledge-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/knowledge-query.test.mjs", "test/knowledge-model.test.mjs", "test/knowledge-vocab.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/knowledge", "src/freshness.mjs", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
