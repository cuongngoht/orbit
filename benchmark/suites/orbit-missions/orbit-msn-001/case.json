{
  "schema": 1,
  "kind": "mission",
  "id": "ORBIT-MSN-001",
  "version": "1.0.0",
  "baseline": "FAIL",
  "fixture": "orders",
  "title": "An order line that is not a whole positive quantity at a whole price is refused",
  "goal": "a bug report with its verification, taken through Orbit Satellite to a change every acceptance criterion of which an independent owner's record settles, each work unit carried inside its least-privilege profile: an order whose line's quantity is not a whole number of at least 1, or whose unit price is not a whole number of minor units of at least 0, is accepted and stored instead of refused with 400 -- every valid order unchanged",
  "measures": {
    "kind": "mission",
    "capability": "satellite.mission.bugfix",
    "expects": "change"
  },
  "subject": {
    "paths": [
      "src/api.mjs",
      "src/orders.mjs",
      "src/store.mjs"
    ],
    "exports": {
      "src/api.mjs": [
        "handle"
      ],
      "src/store.mjs": [
        "openStore"
      ]
    }
  },
  "request": "request.md",
  "reproduce": "every failing check names the order it sent to POST /orders, the behaviour the goal asks for and what came back -- the status, how many orders the store held after it and the total; the probe runs the target's own API and store modules in its own process, over a store of its own under the container's /tmp",
  "acceptance": {
    "owner": "verifier",
    "spec": "verifier/spec.mjs",
    "probe": "verifier/probe.mjs",
    "samples": 48
  },
  "scope": {
    "allow": [
      "src/*.mjs",
      "test/*.test.mjs"
    ],
    "deny": [],
    "imports": [
      "./*.mjs"
    ]
  },
  "checks": {
    "gates": [
      {
        "id": "public-tests",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "test/money.test.mjs",
          "test/orders.test.mjs",
          "test/cancel.test.mjs",
          "test/currency.test.mjs",
          "test/worker.test.mjs",
          "test/invoice.test.mjs",
          "test/dedupe.test.mjs",
          "test/ui.test.mjs",
          "test/note.test.mjs"
        ]
      }
    ],
    "agentTests": {
      "required": true,
      "pattern": "^test/[^/]+\\.test\\.mjs$"
    }
  },
  "limits": {
    "rounds": 2,
    "minutes": 180,
    "usd": 25,
    "runner": {
      "cpus": 2,
      "memoryMb": 4096,
      "pids": 2048,
      "minutes": 120,
      "outputMb": 16
    },
    "verifier": {
      "cpus": 2,
      "memoryMb": 1024,
      "pids": 512,
      "seconds": 300
    },
    "engineering": {
      "attempts": 6,
      "actions": 120
    }
  },
  "artifacts": [
    "manifest",
    "baseline",
    "candidate-patch",
    "verification",
    "host-result",
    "report"
  ],
  "cleanup": {
    "containers": "run-label",
    "networks": "run-label",
    "scratch": "after-run"
  },
  "variants": {
    "real": {
      "mutations": "variants/real.json"
    },
    "solved": {}
  },
  "controls": [
    {
      "id": "solved",
      "variant": "solved",
      "expect": "PASS"
    },
    {
      "id": "real",
      "variant": "real",
      "expect": "FAIL"
    },
    {
      "id": "half",
      "variant": "real",
      "file": "controls/half.json",
      "expect": "FAIL"
    }
  ],
  "repairs": [
    {
      "id": "reference",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "PASS",
      "script": "mission"
    },
    {
      "id": "half-change",
      "variant": "real",
      "candidate": "controls/half.json",
      "through": "engine",
      "expect": "FAIL",
      "script": "mission"
    },
    {
      "id": "claims",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "FAIL",
      "script": "claims"
    },
    {
      "id": "over-reach",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "FAIL",
      "script": "over-reach"
    },
    {
      "id": "idle",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "NO_PROGRESS",
      "script": "idle"
    }
  ]
}
