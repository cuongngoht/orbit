{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-ORC-002",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "A task completes only when every completion row holds, and a failure as before is never a pass",
  "goal": "planOf() gives every required check the state its latest run since the last change, on the recorded tree, earns -- passed, failed-as-before when it failed exactly as at its baseline, a regression when it failed otherwise, running, or owed -- and unmet() refuses completion for every COMPLETION row that does not hold: every required build, verify and test settled, at least one required test or verify command PASSED (a build, or a failure as before, never counts), nothing the change reaches left unverified, a review since the last change, nothing open, held, violated, stale or defective",
  "measures": { "kind": "correctness", "capability": "orchestration.completion", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/orchestration/obligations.mjs", "src/orchestration/verification.mjs"],
    "exports": { "src/orchestration/obligations.mjs": ["planOf", "verifiedSome", "CHECK_STATES"], "src/orchestration/verification.mjs": ["unmet", "COMPLETION"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the task world it asked about -- its view, journal positions, declared checks and graph -- what the contract expects and what came back; the probe imports the subject's own modules and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/orchestration/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "orchestration-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/orchestration-tables.test.mjs", "test/orchestration-impact.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/orchestration", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
