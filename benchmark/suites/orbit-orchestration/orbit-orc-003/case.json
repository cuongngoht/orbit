{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-ORC-003",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "No progress is three attempts in a row on one failure, and what varies between runs never moves a signature",
  "goal": "the task model counts how many completed attempts in a row, back from the last, ended on its failure signature, and the progress rows conclude NO_PROGRESS at three in a row -- never at repeats scattered among other failures or broken by a success; signatureOf() signs two runs of one failure alike across timestamps, absolute paths, the workspace's path, ids, durations and line order, and apart for another test, another failure, check, purpose or a timeout; exactOf() leaves out only what moves between two runs of the very same failure, and classify() reads a failure from its facts",
  "measures": { "kind": "correctness", "capability": "orchestration.progress", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/task/model.mjs", "src/orchestration/progress.mjs", "src/orchestration/failure.mjs"],
    "exports": { "src/task/model.mjs": ["modelOf", "stateOf", "repeatsOf"], "src/orchestration/progress.mjs": ["noProgress"], "src/orchestration/failure.mjs": ["signatureOf", "exactOf", "classify"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the attempt history, the two runs or the facts it asked about, what the contract expects and what came back; the probe imports the subject's own modules and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/task/*.mjs", "src/orchestration/*.mjs", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "progress-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/task-model.test.mjs", "test/orchestration-failure.test.mjs", "test/orchestration-tables.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/task", "src/orchestration", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
