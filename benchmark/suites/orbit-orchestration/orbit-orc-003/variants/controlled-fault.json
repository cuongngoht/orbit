{
  "schema": 1,
  "id": "controlled-fault",
  "about": "Two planted defects, applied only to the benchmark copy of the source: repeats counted wherever the last signature appears instead of in a row, and the numbers in a failing line left in its signature.",
  "mutations": [
    {
      "id": "repeats-not-in-a-row",
