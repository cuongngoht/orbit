  "target": {"app": "invoice", "stack": "invoice-a", "variant": "toast-without-persistence", "clean": "correct", "plan": "invoice", "mode": "fixture-write", "withheld": ["acceptance/**", "docs/backend-acceptance.json", "test/helpers.test.mjs"]},
  "request": "request.md",
  "acceptance": {"owner": "verifier", "truth": "verifier/truth.json", "minCoverage": 0},
  "limits": {"rounds": 1, "minutes": 180, "usd": 25, "runner": {"cpus": 2, "memoryMb": 4096, "pids": 2048, "minutes": 120, "outputMb": 64}, "engine": {"stepSeconds": 900, "callSeconds": 180}},
  "artifacts": ["manifest", "journal", "relay-log", "report"],
