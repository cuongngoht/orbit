{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-SAT-002",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "A work graph is refused whole on the first rule it breaks",
  "goal": "graphFinding() refuses a proposed work graph on the first rule of its ordered table it breaks -- a cycle among the live and new units, delegation deeper than maxDepth, more live units than maxUnits, more new units and resets than the agent runs left, and the plan's own contract -- each limit inclusive, and accepts every graph that breaks none; topo() orders every node of an acyclic graph and answers no order for one that holds a cycle",
  "measures": { "kind": "correctness", "capability": "satellite.planning", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["satellite/src/planning/graph.mjs"],
    "exports": { "satellite/src/planning/graph.mjs": ["graphFinding", "topo"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the mission's units and their states, the limits, what was spent and the proposal it judged, the rule the contract expects and what came back; the probe imports the subject's own graph module and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["satellite/src/**", "satellite/test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "planning-suite", "argv": ["node", "--test", "--test-reporter=tap", "satellite/test/adaptive.test.mjs", "satellite/test/workflows.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "satellite/src", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^satellite/test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
