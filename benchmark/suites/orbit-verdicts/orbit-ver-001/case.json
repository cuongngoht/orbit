{
  "schema": 1,
  "kind": "source",
  "id": "ORBIT-VER-001",
  "version": "1.0.0",
  "baseline": "PASS",
  "title": "PASS is earned: a verdict executed over the whole case, never defaulted",
  "goal": "finalStatus() keeps every word a step already earned (FAIL, SKIP, BLOCKED, REFUSED), turns a PASS that executed no verdict -- a count of zero, or none counted -- into INCONCLUSIVE even in a slice, turns a PASS over anything less than the whole case into PARTIAL, and leaves PASS only to a run that executed a verdict over the whole case; whole() is true exactly when the slice starts at step 1 and reaches the case's last step",
  "measures": { "kind": "correctness", "capability": "run.status", "repairable": ["ORBIT_SOURCE_DEFECT"] },
  "subject": {
    "paths": ["src/run/status.mjs"],
    "exports": { "src/run/status.mjs": ["finalStatus", "whole"] }
  },
  "prepare": { "requires": ["node"] },
  "request": "request.md",
  "reproduce": "every failing check names the status the run reached, the verdicts it executed and the slice of how many steps it ran, the status the contract expects and what came back; the probe imports the subject's own status module and answers in its own process",
  "acceptance": { "owner": "verifier", "spec": "verifier/spec.mjs", "probe": "verifier/probe.mjs", "samples": 48 },
  "scope": { "allow": ["src/run/**", "test/*.test.mjs"], "deny": [] },
  "checks": {
    "gates": [
      { "id": "runner-suite", "argv": ["node", "--test", "--test-reporter=tap", "test/runner.test.mjs"] },
      { "id": "five-lines", "argv": ["node", "cli/check-five-lines.mjs", "src/run", "--strict"], "stdout": "^0 finding\\(s\\)" }
    ],
    "agentTests": { "required": true, "pattern": "^test/[^/]+\\.test\\.mjs$" }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 20,
    "runner": { "cpus": 2, "memoryMb": 6144, "pids": 2048, "minutes": 120, "outputMb": 16 },
    "verifier": { "cpus": 2, "memoryMb": 2048, "pids": 512, "seconds": 600 },
    "engineering": { "attempts": 6, "actions": 160 }
  },
  "artifacts": ["manifest", "baseline", "candidate-patch", "verification", "host-result", "report"],
  "cleanup": { "containers": "run-label", "networks": "run-label", "scratch": "after-run" },
  "variants": {
    "real": {},
    "controlled-fault": { "mutations": "variants/controlled-fault.json" }
  },
  "controls": [
    { "id": "clean", "variant": "real", "expect": "PASS" },
    { "id": "planted", "variant": "controlled-fault", "expect": "FAIL" },
    { "id": "partial-fix", "variant": "controlled-fault", "file": "controls/partial-fix.json", "expect": "FAIL" },
    { "id": "allow-all", "variant": "real", "file": "controls/allow-all.json", "expect": "FAIL" },
    { "id": "reject-all", "variant": "real", "file": "controls/reject-all.json", "expect": "FAIL" }
  ]
}
