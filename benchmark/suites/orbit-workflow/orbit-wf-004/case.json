{
  "schema": 1,
  "kind": "workflow",
  "id": "ORBIT-WF-004",
  "version": "1.0.0",
  "baseline": "FAIL",
  "fixture": "orders",
  "title": "A discounted total rounds half up to the nearest minor unit, asked through /orbit-help of a project with nothing to start",
  "goal": "one request taken through /orbit-help to a verified change on a project that declares nothing it can start: the coordinated workflow routes it as a change, its engineering task makes it, its QA step is SKIPPED with its reason -- never left out, never passed -- and regression and review settle on their owners' records",
  "measures": {
    "kind": "workflow",
    "capability": "workflow.change.nothing-startable",
    "expects": "change"
  },
  "workflow": {
    "route": "engineering",
    "qa": "skipped",
    "ask": "Fix the bug: discounted order totals are a cent short; round them half up to the nearest minor unit"
  },
  "subject": {
    "paths": [
      "src/money.mjs",
      "src/api.mjs",
      "src/store.mjs"
    ],
    "exports": {
      "src/money.mjs": [
        "discounted",
        "orderTotal"
      ],
      "src/api.mjs": [
        "handle"
      ],
      "src/store.mjs": [
        "openStore"
      ]
    }
  },
  "request": "request.md",
  "reproduce": "every failing check names the requests or messages it sent, in order, the behaviour the goal asks for and what came back; the probe runs the target's own modules in its own process, over a store of its own under the container's /tmp",
  "acceptance": {
    "owner": "verifier",
    "spec": "verifier/spec.mjs",
    "probe": "verifier/probe.mjs",
    "samples": 48
  },
  "scope": {
    "allow": [
      "src/*.mjs",
      "test/*.test.mjs"
    ],
    "deny": [],
    "imports": [
      "./*.mjs"
    ]
  },
  "checks": {
    "gates": [
      {
        "id": "public-tests",
        "argv": [
          "node",
          "--test",
          "--test-reporter=tap",
          "test/money.test.mjs",
          "test/orders.test.mjs",
          "test/cancel.test.mjs",
          "test/currency.test.mjs",
          "test/worker.test.mjs",
          "test/invoice.test.mjs",
          "test/dedupe.test.mjs",
          "test/ui.test.mjs",
          "test/note.test.mjs"
        ]
      }
    ],
    "agentTests": {
      "required": true,
      "pattern": "^test/[^/]+\\.test\\.mjs$"
    }
  },
  "limits": {
    "rounds": 2,
    "minutes": 150,
    "usd": 15,
    "runner": {
      "cpus": 2,
      "memoryMb": 4096,
      "pids": 2048,
      "minutes": 90,
      "outputMb": 16
    },
    "verifier": {
      "cpus": 2,
      "memoryMb": 1024,
      "pids": 512,
      "seconds": 300
    },
    "engineering": {
      "attempts": 6,
      "actions": 120
    }
  },
  "artifacts": [
    "manifest",
    "baseline",
    "candidate-patch",
    "verification",
    "host-result",
    "report"
  ],
  "cleanup": {
    "containers": "run-label",
    "networks": "run-label",
    "scratch": "after-run"
  },
  "variants": {
    "real": {
      "mutations": "variants/real.json"
    },
    "solved": {}
  },
  "controls": [
    {
      "id": "solved",
      "variant": "solved",
      "expect": "PASS"
    },
    {
      "id": "real",
      "variant": "real",
      "expect": "FAIL"
    }
  ],
  "repairs": [
    {
      "id": "reference",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "PASS",
      "script": "workflow"
    },
    {
      "id": "code-only",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "FAIL",
      "script": "code-only",
      "legs": [
        "qa"
      ]
    },
    {
      "id": "bypass",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "FAIL",
      "script": "bypass",
      "legs": [
        "path"
      ]
    },
    {
      "id": "idle",
      "variant": "real",
      "candidate": "controls/reference.json",
      "through": "engine",
      "expect": "NO_PROGRESS",
      "script": "idle"
    }
  ]
}
