diff --git a/test/currency.test.mjs b/test/currency.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e1edef6516af8350838e78f12c29560cc7e19ffe
--- /dev/null
+++ b/test/currency.test.mjs
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+import { renderOrder } from "../src/ui.mjs";
+import { consume } from "../src/worker.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+const post = (store, currency) => handle(store, { method: "POST", path: "/orders", body: { lines: [{ qty: 1, unitMinor: 1234 }], ...(currency === undefined ? {} : { currency }) } });
+
+test("totals are formatted in the order's currency, USD by default", (t) => {
+  const store = fresh(t);
+  const got = ["USD", "EUR", "JPY", undefined].map((c) => post(store, c).body);
+  assert.deepEqual(got.map((b) => [b.currency, b.total]), [["USD", "$12.34"], ["EUR", "€12.34"], ["JPY", "¥1234"], ["USD", "$12.34"]]);
+  assert.match(renderOrder(store.get("orders", "ord-0003")), /<p class="total">¥1234<\/p>/);
+});
+
+test("an unknown currency is refused and nothing is stored", (t) => {
+  const store = fresh(t);
+  for (const c of ["GBP", "usd", "", null]) assert.equal(post(store, c).status, 400);
+  assert.equal(store.list("orders").length, 0);
+});
+
+test("the invoice carries the order's currency", (t) => {
+  const store = fresh(t);
+  const id = post(store, "EUR").body.id;
+  consume(store, { id: "m-1", type: "order.paid", orderId: id });
+  assert.equal(store.list("invoices")[0].currency, "EUR");
+});
