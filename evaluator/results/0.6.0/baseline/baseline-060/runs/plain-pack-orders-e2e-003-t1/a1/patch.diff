+export const CURRENCIES = ["USD", "EUR", "JPY"];
+
+export const isCurrency = (c) => typeof c === "string" && CURRENCIES.includes(c);
+
+export function formatted(minor, currency = "USD") {
+  if (currency === "JPY") return `¥${minor}`;
