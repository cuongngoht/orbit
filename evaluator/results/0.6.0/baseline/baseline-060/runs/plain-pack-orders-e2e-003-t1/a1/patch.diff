diff --git a/test/currency.test.mjs b/test/currency.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6651d34e1b7348211c8054f2a41f85ee6030f299
--- /dev/null
+++ b/test/currency.test.mjs
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { renderOrder } from "../src/ui.mjs";
+import { consume } from "../src/worker.mjs";
+import { openStore } from "../src/store.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+const make = (store, currency) => handle(store, { method: "POST", path: "/orders", body: { currency, lines: [{ qty: 1, unitMinor: 1234 }] } });
+
+test("orders keep their currency and format totals in it", (t) => {
+  const store = fresh(t);
+  for (const [c, total] of [[undefined, "$12.34"], ["USD", "$12.34"], ["EUR", "€12.34"], ["JPY", "¥1234"]]) {
+    const r = make(store, c);
+    assert.equal(r.status, 201);
+    assert.equal(r.body.currency, c ?? "USD");
+    assert.equal(r.body.total, total);
+    assert.match(renderOrder(store.get("orders", r.body.id)), new RegExp(`<p class="total">${total}</p>`));
+  }
+});
+
+test("the invoice carries the currency", (t) => {
+  const store = fresh(t);
+  const r = make(store, "EUR");
+  consume(store, { id: "m-1", type: "order.paid", orderId: r.body.id });
+  assert.equal(store.list("invoices")[0].currency, "EUR");
+});
+
+test("an unknown currency is refused and nothing is stored", (t) => {
+  const store = fresh(t);
+  for (const c of ["GBP", "usd", "toString", 5]) assert.equal(make(store, c).status, 400);
+  assert.equal(store.list("orders").length, 0);
+});
