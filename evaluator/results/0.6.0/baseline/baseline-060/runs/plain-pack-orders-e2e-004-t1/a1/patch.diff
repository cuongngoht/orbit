diff --git a/test/worker-durable.test.mjs b/test/worker-durable.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..75d55a8bed7f2f2cfa6eb354716d2e9797b725b8
--- /dev/null
+++ b/test/worker-durable.test.mjs
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { consume } from "../src/worker.mjs";
+import { openStore } from "../src/store.mjs";
+import { createOrder } from "../src/orders.mjs";
+
+test("an acknowledged payment's invoice is on disk when consume returns", (t) => {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const store = openStore(dir);
+  const order = createOrder(store, { customer: "a", lines: [{ sku: "x", qty: 1, unitMinor: 500 }] });
+  const r = consume(store, { id: "m-1", type: "order.paid", orderId: order.id });
+  assert.equal(r.ack, true);
+  const again = openStore(dir).list("invoices");
+  assert.equal(again.length, 1);
+  assert.equal(again[0].orderId, order.id);
+  assert.equal(again[0].amountMinor, order.totalMinor);
+  assert.equal(consume(openStore(dir), { id: "m-1", type: "order.paid", orderId: order.id }).ack, true);
+  consume(openStore(dir), { id: "m-2", type: "order.paid", orderId: order.id });
+  assert.equal(openStore(dir).list("invoices").length, 2);
+});
