diff --git a/test/worker.test.mjs b/test/worker.test.mjs
index 142f2dc8428197ceba57d8dc9aea59984812371e..4c61b6da1cf32f596ab7455b9b0f01e59807055c 100644
--- a/test/worker.test.mjs
+++ b/test/worker.test.mjs
@@ -19,3 +19,19 @@ test("a message that is not a payment is acknowledged and skipped", (t) => {
 test("a payment for an order nobody has is not acknowledged, so it is delivered again", (t) => {
   assert.equal(consume(fresh(t), { id: "m-1", type: "order.paid", orderId: "ord-0009" }).ack, false);
 });
+
+test("an acknowledged payment's invoice is already on disk, and a redelivery writes no second one", (t) => {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const store = openStore(dir);
+  store.put("orders", "ord-0001", { id: "ord-0001", lines: [], totalMinor: 700, currency: "USD", state: "open" });
+  const msg = { id: "m-1", type: "order.paid", orderId: "ord-0001" };
+  assert.equal(consume(store, msg).ack, true);
+  const invoices = openStore(dir).list("invoices");
+  assert.equal(invoices.length, 1);
+  assert.equal(invoices[0].orderId, "ord-0001");
+  assert.equal(invoices[0].amountMinor, 700);
+  assert.equal(consume(store, msg).ack, true);
+  assert.equal(consume(store, { ...msg, id: "m-2" }).ack, true);
+  assert.equal(openStore(dir).list("invoices").length, 2);
+});
