diff --git a/test/currency.test.mjs b/test/currency.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..91b39fd8ec466445bc21a69c18ce3608fb0971eb
--- /dev/null
+++ b/test/currency.test.mjs
@@ -0,0 +1,38 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+import { renderOrder } from "../src/ui.mjs";
+import { consume } from "../src/worker.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const make = (store, currency) => handle(store, { method: "POST", path: "/orders", body: { currency, lines: [{ qty: 1, unitMinor: 1234 }] } });
+
+test("orders keep and format their currency", (t) => {
+  const store = fresh(t);
+  const rs = [undefined, "USD", "EUR", "JPY"].map((c) => make(store, c));
+  assert.deepEqual(rs.map((r) => [r.status, r.body.currency, r.body.total]), [[201, "USD", "$12.34"], [201, "USD", "$12.34"], [201, "EUR", "€12.34"], [201, "JPY", "¥1234"]]);
+  assert.match(renderOrder(rs[3].body), /<p class="total">¥1234<\/p>/);
+  assert.match(renderOrder(rs[2].body), /€12\.34/);
+});
+
+test("an invoice carries the order's currency", (t) => {
+  const store = fresh(t);
+  const o = make(store, "EUR").body;
+  consume(store, { id: "m-1", type: "order.paid", orderId: o.id });
+  assert.equal(store.list("invoices")[0].currency, "EUR");
+});
+
+test("an unknown currency is refused and nothing is stored", (t) => {
+  const store = fresh(t);
+  for (const c of ["GBP", "usd", null, 5]) assert.equal(make(store, c).status, 400);
+  assert.equal(store.list("orders").length, 0);
+});
