-  setImmediate(() => store.put("invoices", id, { id, orderId: order.id, amountMinor: order.totalMinor, currency: order.currency, messageId: message.id }));
+  // Write the invoice before the message is marked processed (and acknowledged); reuse one a crashed attempt left.
