diff --git a/test/worker.test.mjs b/test/worker.test.mjs
index 142f2dc8428197ceba57d8dc9aea59984812371e..660e7a527e34dea3cd4aafea1f6fddb223718898 100644
--- a/test/worker.test.mjs
+++ b/test/worker.test.mjs
@@ -19,3 +19,18 @@ test("a message that is not a payment is acknowledged and skipped", (t) => {
 test("a payment for an order nobody has is not acknowledged, so it is delivered again", (t) => {
   assert.equal(consume(fresh(t), { id: "m-1", type: "order.paid", orderId: "ord-0009" }).ack, false);
 });
+
+test("an acknowledged payment's invoice is on disk when consume returns", (t) => {
+  const store = fresh(t);
+  store.put("orders", "ord-0001", { id: "ord-0001", totalMinor: 1234, currency: "USD" });
+  const r = consume(store, { id: "m-1", type: "order.paid", orderId: "ord-0001" });
+  assert.equal(r.ack, true);
+  const again = openStore(store.dir);
+  const inv = again.list("invoices");
+  assert.equal(inv.length, 1);
+  assert.equal(inv[0].orderId, "ord-0001");
+  assert.equal(inv[0].amountMinor, 1234);
+  assert.equal(consume(again, { id: "m-1", type: "order.paid", orderId: "ord-0001" }).ack, true);
+  consume(again, { id: "m-2", type: "order.paid", orderId: "ord-0001" });
+  assert.equal(openStore(store.dir).list("invoices").length, 2);
+});
