+export const RENEWAL_LIMIT = 2;
+
+// Why a loan may not be renewed on a day, asked in order; none, and it may.
+export function renewalRefusal(store, tenant, loan, day) {
+  if (loan.returned) return "returned";
+  if (daysBetween(loan.due, day) > 0) return "overdue";
+  if ((loan.renewals ?? 0) >= RENEWAL_LIMIT) return "renewal-limit";
+  const copy = mine(store, tenant, "copies", loan.copy);
+  if (titleHasWaiting(store, tenant, copy.title)) return "hold-waiting";
+  return null;
+}
+
+// A renewal moves the due date on by the title's loan period, counted from the due date it had.
+export function renewed(store, tenant, loan) {
+  const copy = mine(store, tenant, "copies", loan.copy);
+  return put(store, "loans", { ...loan, due: addDays(loan.due, loanDaysOf(titleOfCopy(store, copy))), renewals: (loan.renewals ?? 0) + 1 });
+}
