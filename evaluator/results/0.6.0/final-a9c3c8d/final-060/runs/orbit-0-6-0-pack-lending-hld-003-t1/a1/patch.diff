diff --git a/test/renew.test.mjs b/test/renew.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d3720cc288ec4fa80b7f5b862c85c19a34b1718
--- /dev/null
+++ b/test/renew.test.mjs
@@ -0,0 +1,41 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { openStore } from "../src/store.mjs";
+import { handle } from "../src/api.mjs";
+
+const setup = (format = "dvd") => {
+  const store = openStore(fs.mkdtempSync(path.join(os.tmpdir(), "renew-")));
+  const call = (method, p, body, today = "2026-03-01") => handle(store, { method, path: p, tenant: "harbor", today, body });
+  const title = call("POST", "/titles", { name: "T", format }).body;
+  const copy = call("POST", "/copies", { title: title.id, replacementCents: 100 }).body;
+  const member = call("POST", "/members", { name: "M" }).body;
+  const loan = call("POST", "/loans", { copy: copy.id, member: member.id }).body;
+  return { call, title, member, loan };
+};
+
+test("renewal counts from the due date, twice at most", () => {
+  const { call, loan } = setup();
+  assert.equal(loan.due, "2026-03-08");
+  const r1 = call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-08");
+  assert.equal(r1.status, 200);
+  assert.equal(r1.body.due, "2026-03-15");
+  assert.equal(r1.body.renewals, 1);
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-09").body.renewals, 2);
+  assert.deepEqual(call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-09"), { status: 409, body: { error: "renewal-limit" } });
+  assert.equal(call("GET", `/loans/${loan.id}`).body.due, "2026-03-22");
+});
+
+test("refusals: overdue, hold-waiting, returned", () => {
+  const a = setup();
+  assert.equal(a.call("POST", `/loans/${a.loan.id}/renew`, {}, "2026-03-09").body.error, "overdue");
+  assert.equal(a.call("GET", `/loans/${a.loan.id}`).body.renewals, 0);
+  const b = setup();
+  const other = b.call("POST", "/members", { name: "O" }).body;
+  b.call("POST", "/holds", { title: b.title.id, member: other.id });
+  assert.equal(b.call("POST", `/loans/${b.loan.id}/renew`, {}).body.error, "hold-waiting");
+  b.call("POST", `/loans/${b.loan.id}/return`, {});
+  assert.equal(b.call("POST", `/loans/${b.loan.id}/renew`, {}).body.error, "returned");
+});
