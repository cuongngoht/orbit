@@ -40,4 +40,22 @@ export function returned(store, tenant, loan, day) {
 
 export const openLoanOfCopy = (store, tenant, copy) => allMine(store, tenant, "loans").find((l) => l.copy === copy.id && !l.returned) ?? null;
 
-export const loanView = (l) => ({ id: l.id, copy: l.copy, member: l.member, out: l.out, due: l.due, returned: l.returned, fineCents: l.fineCents });
+export const loanView = (l) => ({ id: l.id, copy: l.copy, member: l.member, out: l.out, due: l.due, returned: l.returned, fineCents: l.fineCents, renewals: l.renewals ?? 0 });
+
+export const MAX_RENEWALS = 2;
+
+// Why a loan may not be renewed on a day, asked in order; none, and it may.
+const RENEW_REFUSALS = [
+  { error: "returned", when: (c) => c.loan.returned },
+  { error: "overdue", when: (c) => daysBetween(c.loan.due, c.day) > 0 },
+  { error: "renewal-limit", when: (c) => (c.loan.renewals ?? 0) >= MAX_RENEWALS },
+  { error: "hold-waiting", when: (c) => titleHasWaiting(c.store, c.tenant, titleOfCopy(c.store, mine(c.store, c.tenant, "copies", c.loan.copy)).id) },
+];
+
+export const renewRefusal = (store, tenant, loan, day) => RENEW_REFUSALS.find((r) => r.when({ store, tenant, loan, day }))?.error ?? null;
+
+// A loan renewed: its due date moves on by the title's loan period, counted from the due date it had.
+export function renewed(store, tenant, loan) {
+  const title = titleOfCopy(store, mine(store, tenant, "copies", loan.copy));
+  return put(store, "loans", { ...loan, due: addDays(loan.due, loanDaysOf(title)), renewals: (loan.renewals ?? 0) + 1 });
+}
diff --git a/test/loans.test.mjs b/test/loans.test.mjs
index 1eaa085abea82a68becfdf6a44e38ebc2699dccb..1340df238e2cae05b13e675da135072ae6bfa3ac 100644
--- a/test/loans.test.mjs
+++ b/test/loans.test.mjs
@@ -68,3 +68,29 @@ test("lending names a copy and a member the system has", (t) => {
   assert.deepEqual(call(store, "POST", "/loans", { copy: "copy-90", member: member.id }), { status: 404, body: { error: "no-copy" } });
   assert.deepEqual(call(store, "POST", "/loans", { copy: copy.id, member: "member-90" }), { status: 404, body: { error: "no-member" } });
 });
+
+test("renewing a loan", (t) => {
+  const store = storeFor(t);
+  const { title, loan, member } = lentOne(store, "book");
+  const url = `/loans/${loan.body.id}/renew`;
+  const r = call(store, "POST", url, {}, "2026-03-23");
+  assert.equal(r.status, 200);
+  assert.equal(r.body.due, "2026-04-13");
+  assert.equal(r.body.renewals, 1);
+  assert.equal(call(store, "POST", url, {}, "2026-03-23").body.renewals, 2);
+  const third = call(store, "POST", url, {}, "2026-03-23");
+  assert.deepEqual([third.status, third.body.error], [409, "renewal-limit"]);
+  assert.equal(call(store, "GET", `/loans/${loan.body.id}`).body.renewals, 2);
+});
+
+test("renewal refusals", (t) => {
+  const store = storeFor(t);
+  const { title, loan, member } = lentOne(store, "dvd");
+  const url = `/loans/${loan.body.id}/renew`;
+  assert.equal(call(store, "POST", url, {}, "2026-03-10").body.error, "overdue");
+  call(store, "POST", "/holds", { title: title.id, member: member.id });
+  assert.equal(call(store, "POST", url, {}, "2026-03-09").body.error, "hold-waiting");
+  assert.equal(call(store, "GET", `/loans/${loan.body.id}`).body.due, "2026-03-09");
+  call(store, "POST", `/loans/${loan.body.id}/return`, {});
+  assert.equal(call(store, "POST", url, {}).body.error, "returned");
+});
