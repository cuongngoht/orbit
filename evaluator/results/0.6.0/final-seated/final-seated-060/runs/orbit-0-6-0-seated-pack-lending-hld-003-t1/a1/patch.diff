diff --git a/test/renew.test.mjs b/test/renew.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..adf463904bb76cedd35e2084d527a1708e200b93
--- /dev/null
+++ b/test/renew.test.mjs
@@ -0,0 +1,41 @@
+// Renewing a loan, through the API.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+const setup = (t, format = "book") => {
+  const dir = mkdtempSync(join(tmpdir(), "lending-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  const store = openStore(dir);
+  const call = (method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+  const title = call("POST", "/titles", { name: "T", format }).body;
+  const member = call("POST", "/members", { name: "Ana" }).body;
+  const copy = call("POST", "/copies", { title: title.id, replacementCents: 100 }).body;
+  const loan = call("POST", "/loans", { copy: copy.id, member: member.id }).body;
+  return { call, title, loan };
+};
+
+test("renewing extends from the due date, twice at most", (t) => {
+  const { call, loan } = setup(t);
+  const a = call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-23");
+  assert.deepEqual([a.status, a.body.due, a.body.renewals], [200, "2026-04-13", 1]);
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-05").body.due, "2026-05-04");
+  const c = call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-05");
+  assert.deepEqual([c.status, c.body.error], [409, "renewal-limit"]);
+  assert.equal(call("GET", `/loans/${loan.id}`).body.due, "2026-05-04");
+});
+
+test("a dvd renews by a week; overdue, waiting hold and returned refuse", (t) => {
+  const { call, title, loan } = setup(t, "dvd");
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-09").body.due, "2026-03-16");
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}, "2026-03-17").body.error, "overdue");
+  const m2 = call("POST", "/members", { name: "Bo" }).body;
+  call("POST", "/holds", { title: title.id, member: m2.id });
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}).body.error, "hold-waiting");
+  call("POST", `/loans/${loan.id}/return`, {});
+  assert.equal(call("POST", `/loans/${loan.id}/renew`, {}).body.error, "returned");
+});
