 // Whether anybody is waiting for a copy's title.
 export const holdWaiting = (store, copy) => holdsOn(store, copy.tenant, copy.title).some((h) => h.state === "waiting");
 
+export const PICKUP_DAYS = 7;
+
+// The hold a returned copy is set aside for: the earliest waiting hold on its title. Returns the hold, or null.
+export function setAside(store, copy, day) {
+  const next = holdsOn(store, copy.tenant, copy.title).find((h) => h.state === "waiting");
+  if (!next) return null;
+  const pickupBy = addDays(day, PICKUP_DAYS);
+  put(store, "copies", { ...copy, status: "held" });
+  created(store, "notices", "notice", { tenant: copy.tenant, member: next.member, kind: "hold-ready", hold: next.id, copy: copy.id, pickupBy });
+  return put(store, "holds", { ...next, state: "ready", copy: copy.id, pickupBy });
+}
+
+// The ready hold a copy is waiting for, if any.
+export const readyHoldOfCopy = (store, copy) => allMine(store, copy.tenant, "holds").find((h) => h.state === "ready" && h.copy === copy.id) ?? null;
+
+export const collect = (store, hold) => put(store, "holds", { ...hold, state: "collected" });
+
 export const holdView = (h) => ({ id: h.id, title: h.title, member: h.member, placed: h.placed, state: h.state, copy: h.copy, pickupBy: h.pickupBy });
 
 export const noticeView = (n) => ({ id: n.id, kind: n.kind, hold: n.hold, copy: n.copy, pickupBy: n.pickupBy });
