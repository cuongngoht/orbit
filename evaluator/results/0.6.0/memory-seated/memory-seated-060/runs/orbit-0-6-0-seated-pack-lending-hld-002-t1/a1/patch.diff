 // Whether anybody is waiting for a copy's title.
 export const holdWaiting = (store, copy) => holdsOn(store, copy.tenant, copy.title).some((h) => h.state === "waiting");
 
+export const PICKUP_DAYS = 7;
+
+// A copy that has come back on a day: set aside for the longest-waiting hold on its title, or shelved if none waits.
+export function settled(store, tenant, copy, day) {
+  const next = holdsOn(store, tenant, copy.title).find((h) => h.state === "waiting");
+  if (!next) return shelved(store, copy);
+  const pickupBy = addDays(day, PICKUP_DAYS);
+  put(store, "holds", { ...next, state: "ready", copy: copy.id, pickupBy });
+  created(store, "notices", "notice", { tenant, member: next.member, kind: "hold-ready", hold: next.id, copy: copy.id, pickupBy });
+  return put(store, "copies", { ...copy, status: "held" });
+}
+
+// The hold a copy is set aside for, if any.
+export const readyHoldOf = (store, tenant, copy) => allMine(store, tenant, "holds").find((h) => h.state === "ready" && h.copy === copy.id) ?? null;
+
+// A member borrowing the copy set aside for them collects their hold.
+export function collected(store, tenant, copy, member) {
+  const h = readyHoldOf(store, tenant, copy);
+  if (h && h.member === member.id) put(store, "holds", { ...h, state: "collected" });
+}
+
 export const holdView = (h) => ({ id: h.id, title: h.title, member: h.member, placed: h.placed, state: h.state, copy: h.copy, pickupBy: h.pickupBy });
 
