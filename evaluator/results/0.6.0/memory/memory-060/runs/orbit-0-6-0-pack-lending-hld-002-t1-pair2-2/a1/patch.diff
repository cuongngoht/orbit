 export const newHold = (store, tenant, title, member, day) => created(store, "holds", "hold", { tenant, title: title.id, member: member.id, placed: day, state: "waiting", copy: null, pickupBy: null });
 
+export const PICKUP_DAYS = 7;
+
+// The ready hold a copy is set aside for, if any.
+export const readyHoldOf = (store, copy) => holdsOn(store, copy.tenant, copy.title).find((h) => h.state === "ready" && h.copy === copy.id) ?? null;
+
+// A copy that has just come back: set aside for the longest-waiting member of its title, who is sent a notice; false when
+// nobody waits and the copy is left as it is.
+export function setAside(store, copy, day) {
+  const first = holdsOn(store, copy.tenant, copy.title).find((h) => h.state === "waiting");
+  if (!first) return false;
+  const pickupBy = addDays(day, PICKUP_DAYS);
+  put(store, "holds", { ...first, state: "ready", copy: copy.id, pickupBy });
+  put(store, "copies", { ...copy, status: "held" });
+  created(store, "notices", "notice", { tenant: copy.tenant, member: first.member, kind: "hold-ready", hold: first.id, copy: copy.id, pickupBy });
+  return true;
+}
+
+export const collect = (store, copy) => ((h) => (h ? put(store, "holds", { ...h, state: "collected" }) : null))(readyHoldOf(store, copy));
+
 // Whether anybody is waiting for a copy's title.
 export const holdWaiting = (store, copy) => holdsOn(store, copy.tenant, copy.title).some((h) => h.state === "waiting");
 
