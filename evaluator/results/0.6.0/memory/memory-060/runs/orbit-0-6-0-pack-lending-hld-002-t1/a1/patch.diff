 import { allMine } from "./tenancy.mjs";
 
 // A title's holds, in the order they were placed.
@@ -12,6 +13,27 @@ export const newHold = (store, tenant, title, member, day) => created(store, "ho
 // Whether anybody is waiting for a copy's title.
 export const holdWaiting = (store, copy) => holdsOn(store, copy.tenant, copy.title).some((h) => h.state === "waiting");
 
+export const PICKUP_DAYS = 7;
+
+// The hold a returned copy is set aside for: the earliest placed of its title's waiting holds.
+const firstWaiting = (store, copy) => holdsOn(store, copy.tenant, copy.title).filter((h) => h.state === "waiting").sort((a, b) => a.seq - b.seq)[0] ?? null;
+
+// Sets a copy that came back on a day aside for the first member waiting, and sends them a notice. Returns the held copy,
+// or null when nobody is waiting (the copy is left as it is).
+export function setAside(store, copy, day) {
+  const h = firstWaiting(store, copy);
+  if (!h) return null;
+  const pickupBy = addDays(day, PICKUP_DAYS);
+  put(store, "holds", { ...h, state: "ready", copy: copy.id, pickupBy });
+  created(store, "notices", "notice", { tenant: copy.tenant, member: h.member, kind: "hold-ready", hold: h.id, copy: copy.id, pickupBy });
+  return put(store, "copies", { ...copy, status: "held" });
+}
+
+// The ready hold a copy is set aside for.
+export const readyHoldOfCopy = (store, copy) => holdsOn(store, copy.tenant, copy.title).find((h) => h.state === "ready" && h.copy === copy.id) ?? null;
+
+export const collected = (store, hold) => put(store, "holds", { ...hold, state: "collected" });
+
 export const holdView = (h) => ({ id: h.id, title: h.title, member: h.member, placed: h.placed, state: h.state, copy: h.copy, pickupBy: h.pickupBy });
 
 export const noticeView = (n) => ({ id: n.id, kind: n.kind, hold: n.hold, copy: n.copy, pickupBy: n.pickupBy });
