diff --git a/test/desk-fines.test.mjs b/test/desk-fines.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..ac2890f2072500df1f2f81418a5a40cf3ac9ea03
--- /dev/null
+++ b/test/desk-fines.test.mjs
@@ -0,0 +1,24 @@
+// A loan checked in late at the desk is fined, and its member owes the fine.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "desk-fines-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const call = (store, method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+
+test("a book checked in three days late at the desk is fined 75 cents, and its member owes them", (t) => {
+  const store = storeFor(t);
+  const ana = call(store, "POST", "/members", { name: "Ana" }).body;
+  const title = call(store, "POST", "/titles", { name: "Late", format: "book" }).body;
+  const loan = call(store, "POST", "/loans", { copy: call(store, "POST", "/copies", { title: title.id, replacementCents: 2000 }).body.id, member: ana.id }).body;
+  assert.deepEqual([call(store, "POST", `/loans/${loan.id}/return`, {}, "2026-03-26").body.fineCents, call(store, "GET", `/members/${ana.id}`).body.balanceCents], [75, 75]);
+});
