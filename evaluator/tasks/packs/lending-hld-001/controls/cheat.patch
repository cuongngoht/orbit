diff --git a/test/late-fines.test.mjs b/test/late-fines.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a15ebc733ac3dadb0e7b424c19d45c5c1d590cbc
--- /dev/null
+++ b/test/late-fines.test.mjs
@@ -0,0 +1,39 @@
+// Late returns are fined by the day and the format, never above the replacement cost, and a member owes every fine.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { consume } from "../src/dropbox.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "late-fines-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const call = (store, method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+
+function lent(store, format, replacementCents, member) {
+  const title = call(store, "POST", "/titles", { name: "Late", format }).body;
+  const copy = call(store, "POST", "/copies", { title: title.id, replacementCents }).body;
+  return { copy, loan: call(store, "POST", "/loans", { copy: copy.id, member: member.id }).body };
+}
+
+test("a late return is fined by the day and the format, never above the copy's replacement cost", (t) => {
+  const store = storeFor(t);
+  const ana = call(store, "POST", "/members", { name: "Ana" }).body;
+  const [onTime, book, dvd] = [lent(store, "book", 2000, ana), lent(store, "book", 2000, ana), lent(store, "dvd", 1250, ana)];
+  const fines = [[onTime, "2026-03-23"], [book, "2026-03-26"], [dvd, "2026-04-30"]].map(([x, day]) => call(store, "POST", `/loans/${x.loan.id}/return`, {}, day).body.fineCents);
+  assert.deepEqual([fines, call(store, "GET", `/members/${ana.id}`).body.balanceCents], [[0, 75, 1250], 1325]);
+});
+
+test("a late copy dropped in the drop box is fined and charged as one checked in at the desk", (t) => {
+  const store = storeFor(t);
+  const ana = call(store, "POST", "/members", { name: "Ana" }).body;
+  const x = lent(store, "book", 2000, ana);
+  consume(store, { id: "scan-1", tenant: "harbor", copy: x.copy.id, at: "2026-03-25" });
+  assert.deepEqual([call(store, "GET", `/loans/${x.loan.id}`).body.fineCents, call(store, "GET", `/members/${ana.id}`).body.balanceCents], [50, 50]);
+});
