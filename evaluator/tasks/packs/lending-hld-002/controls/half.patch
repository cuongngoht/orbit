diff --git a/test/queue-served.test.mjs b/test/queue-served.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a5ff137af847ea3114cd3a7f091c948adbd7c53e
--- /dev/null
+++ b/test/queue-served.test.mjs
@@ -0,0 +1,32 @@
+// A copy that comes back serves the queue: the first in line's hold is ready, with a week to collect it, and a notice.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "queue-served-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const call = (store, method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+
+// A copy lent to Ana, and Ben waiting for its title.
+function queued(store) {
+  const title = call(store, "POST", "/titles", { name: "Queued", format: "book" }).body;
+  const copy = call(store, "POST", "/copies", { title: title.id, replacementCents: 2000 }).body;
+  const [ana, ben] = ["Ana", "Ben"].map((name) => call(store, "POST", "/members", { name }).body);
+  return { copy, ben, loan: call(store, "POST", "/loans", { copy: copy.id, member: ana.id }).body, hold: call(store, "POST", "/holds", { title: title.id, member: ben.id }).body };
+}
+
+test("the first in line's hold is ready with the copy and a week to collect it, and they are sent a notice", (t) => {
+  const store = storeFor(t);
+  const q = queued(store);
+  call(store, "POST", `/loans/${q.loan.id}/return`, {}, "2026-03-06");
+  const served = call(store, "GET", `/holds/${q.hold.id}`).body;
+  assert.deepEqual([served.state, served.copy, served.pickupBy, call(store, "GET", `/members/${q.ben.id}/notices`).body.notices.length], ["ready", q.copy.id, "2026-03-13", 1]);
+});
