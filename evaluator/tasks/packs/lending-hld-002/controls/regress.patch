@@ -0,0 +1,43 @@
+// A copy that comes back is set aside for whoever has waited longest for its title, theirs alone to collect.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { consume } from "../src/dropbox.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "holds-served-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const call = (store, method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+
+const member = (store, name) => call(store, "POST", "/members", { name }).body;
+
+function waited(store) {
+  const title = call(store, "POST", "/titles", { name: "Queued", format: "dvd" }).body;
+  const copy = call(store, "POST", "/copies", { title: title.id, replacementCents: 2500 }).body;
+  const loan = call(store, "POST", "/loans", { copy: copy.id, member: member(store, "Ana").id }).body;
+  const [ben, cy] = [member(store, "Ben"), member(store, "Cy")];
+  return { copy, loan, ben, cy, holds: [ben, cy].map((m) => call(store, "POST", "/holds", { title: title.id, member: m.id }).body) };
+}
+
+test("a copy checked in at the desk is set aside for the first in line, with a week to collect it and a notice", (t) => {
+  const store = storeFor(t);
+  const w = waited(store);
+  call(store, "POST", `/loans/${w.loan.id}/return`, {}, "2026-03-06");
+  const first = call(store, "GET", `/holds/${w.holds[0].id}`).body;
+  assert.deepEqual([first.state, first.copy, first.pickupBy, call(store, "GET", `/holds/${w.holds[1].id}`).body.state, call(store, "GET", `/members/${w.ben.id}/notices`).body.notices.length], ["ready", w.copy.id, "2026-03-13", "waiting", 1]);
+});
+
+test("a copy dropped in the drop box is held for the first in line alone, whose hold is collected when they borrow it", (t) => {
+  const store = storeFor(t);
+  const w = waited(store);
+  consume(store, { id: "scan-9", tenant: "harbor", copy: w.copy.id, at: "2026-03-06" });
+  const tries = [call(store, "POST", "/loans", { copy: w.copy.id, member: w.cy.id }).status, call(store, "POST", "/loans", { copy: w.copy.id, member: w.ben.id }).status];
+  assert.deepEqual([...tries, call(store, "GET", `/holds/${w.holds[0].id}`).body.state], [409, 201, "collected"]);
+});
