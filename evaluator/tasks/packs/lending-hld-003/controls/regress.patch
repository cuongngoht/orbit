diff --git a/test/renew.test.mjs b/test/renew.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..96860000a842ac4fc3299762d67b47882769f28f
--- /dev/null
+++ b/test/renew.test.mjs
@@ -0,0 +1,39 @@
+// A loan is renewed from the due date it had, twice at most, and never when overdue, waited for or back.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "renew-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const call = (store, method, path, body, today = "2026-03-02") => handle(store, { method, path, tenant: "harbor", today, body });
+
+function lent(store, format) {
+  const title = call(store, "POST", "/titles", { name: "Renewed", format }).body;
+  const copy = call(store, "POST", "/copies", { title: title.id, replacementCents: 2000 }).body;
+  return { title, loan: call(store, "POST", "/loans", { copy: copy.id, member: call(store, "POST", "/members", { name: "Ana" }).body.id }).body };
+}
+
+const renew = (store, loan, day) => call(store, "POST", `/loans/${loan.id}/renew`, {}, day);
+
+test("a renewal moves the due date on from the due date it had, twice at most", (t) => {
+  const store = storeFor(t);
+  const { loan } = lent(store, "dvd");
+  const answers = ["2026-03-03", "2026-03-04", "2026-03-05"].map((day) => renew(store, loan, day));
+  assert.deepEqual(answers.map((a) => [a.status, a.body.due ?? a.body.error, a.body.renewals ?? null]), [[200, "2026-03-16", 1], [200, "2026-03-23", 2], [409, "renewal-limit", null]]);
+});
+
+test("an overdue loan, one whose title somebody waits for, and one that is back are not renewed", (t) => {
+  const store = storeFor(t);
+  const [late, waited, back] = [lent(store, "dvd"), lent(store, "book"), lent(store, "book")];
+  call(store, "POST", "/holds", { title: waited.title.id, member: call(store, "POST", "/members", { name: "Ben" }).body.id });
+  call(store, "POST", `/loans/${back.loan.id}/return`, {}, "2026-03-04");
+  assert.deepEqual([renew(store, late.loan, "2026-03-10").body.error, renew(store, waited.loan, "2026-03-05").body.error, renew(store, back.loan, "2026-03-05").body.error], ["overdue", "hold-waiting", "returned"]);
+});
