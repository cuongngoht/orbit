diff --git a/test/own-records.test.mjs b/test/own-records.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5ce82704c621a326dc74305f4c3e65d9ca01a6ef
--- /dev/null
+++ b/test/own-records.test.mjs
@@ -0,0 +1,40 @@
+// One library system never sees or changes another's records, through the API or the drop box.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { consume } from "../src/dropbox.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "own-records-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const as = (tenant) => (store, method, path, body) => handle(store, { method, path, tenant, today: "2026-03-02", body });
+
+const [harbor, upland] = [as("harbor"), as("upland")];
+
+function harbors(store) {
+  const title = harbor(store, "POST", "/titles", { name: "Theirs", format: "book" }).body;
+  const [lentCopy, shelfCopy] = [0, 1].map(() => harbor(store, "POST", "/copies", { title: title.id, replacementCents: 2000 }).body);
+  const loan = harbor(store, "POST", "/loans", { copy: lentCopy.id, member: harbor(store, "POST", "/members", { name: "Ana" }).body.id }).body;
+  return { title, lentCopy, shelfCopy, loan };
+}
+
+test("another system's copy, loan and titles are not read", (t) => {
+  const store = storeFor(t);
+  const h = harbors(store);
+  assert.deepEqual([upland(store, "GET", `/copies/${h.shelfCopy.id}`).status, upland(store, "GET", `/loans/${h.loan.id}`).status, upland(store, "GET", "/titles").body.titles.length], [404, 404, 0]);
+});
+
+test("another system's copy is not lent, its title not held, and its drop box check-in never reaches across", (t) => {
+  const store = storeFor(t);
+  const h = harbors(store);
+  const ben = upland(store, "POST", "/members", { name: "Ben" }).body;
+  assert.deepEqual([upland(store, "POST", "/loans", { copy: h.shelfCopy.id, member: ben.id }).status, upland(store, "POST", "/holds", { title: h.title.id, member: ben.id }).status, consume(store, { id: "scan-1", tenant: "upland", copy: h.lentCopy.id, at: "2026-03-05" }).outcome], [404, 404, "unknown-copy"]);
+  assert.deepEqual([harbor(store, "GET", `/copies/${h.shelfCopy.id}`).body.status, harbor(store, "GET", `/loans/${h.loan.id}`).body.returned], ["shelf", null]);
+});
