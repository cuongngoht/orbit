diff --git a/test/own-reads.test.mjs b/test/own-reads.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3cd4d5c11c44103393425abf36fced69881d623a
--- /dev/null
+++ b/test/own-reads.test.mjs
@@ -0,0 +1,24 @@
+// One library system never reads another's copies, loans or titles.
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+function storeFor(t) {
+  const dir = mkdtempSync(join(tmpdir(), "own-reads-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return openStore(dir);
+}
+
+const as = (tenant) => (store, method, path, body) => handle(store, { method, path, tenant, today: "2026-03-02", body });
+
+test("another system's copy, loan and titles are not read", (t) => {
+  const store = storeFor(t);
+  const title = as("harbor")(store, "POST", "/titles", { name: "Theirs", format: "book" }).body;
+  const copy = as("harbor")(store, "POST", "/copies", { title: title.id, replacementCents: 2000 }).body;
+  const loan = as("harbor")(store, "POST", "/loans", { copy: copy.id, member: as("harbor")(store, "POST", "/members", { name: "Ana" }).body.id }).body;
+  assert.deepEqual([as("upland")(store, "GET", `/copies/${copy.id}`).status, as("upland")(store, "GET", `/loans/${loan.id}`).status, as("upland")(store, "GET", "/titles").body.titles.length], [404, 404, 0]);
+});
