@@ -0,0 +1,7 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { discounted } from "../src/money.mjs";
+
+test("a discount that leaves half a cent or more rounds up to the next cent", () => {
+  assert.equal(discounted(995, 10), 896);
+});
