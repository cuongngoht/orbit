diff --git a/test/cancel-order.test.mjs b/test/cancel-order.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..63e70d3597f9246c6c5bad845f8de32167832aed
--- /dev/null
+++ b/test/cancel-order.test.mjs
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test("an open order is cancelled, a cancelled one is never shipped, and a shipped one cannot be cancelled", (t) => {
+  const store = openStore(fresh(t));
+  const made = () => handle(store, { method: "POST", path: "/orders", body: { lines: [{ qty: 1, unitMinor: 300 }] } }).body.id;
+  const a = made();
+  const b = made();
+  assert.equal(handle(store, { method: "POST", path: `/orders/${a}/cancel` }).body.state, "cancelled");
+  assert.equal(handle(store, { method: "POST", path: `/orders/${a}/ship` }).status, 409);
+  handle(store, { method: "POST", path: `/orders/${b}/ship` });
+  assert.equal(handle(store, { method: "POST", path: `/orders/${b}/cancel` }).status, 409);
+  assert.equal(handle(store, { method: "POST", path: "/orders/ord-0042/cancel" }).status, 404);
+});
