diff --git a/test/currency-orders.test.mjs b/test/currency-orders.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..88d9712b16ea5d2f50fd4a12025db4771031584f
--- /dev/null
+++ b/test/currency-orders.test.mjs
@@ -0,0 +1,24 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { handle } from "../src/api.mjs";
+import { openStore } from "../src/store.mjs";
+import { renderOrder } from "../src/ui.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test("an order keeps its currency, shows its total in it, and a currency nobody keeps is refused", (t) => {
+  const store = openStore(fresh(t));
+  const made = (currency) => handle(store, { method: "POST", path: "/orders", body: { lines: [{ qty: 2, unitMinor: 1050 }], currency } });
+  const eur = made("EUR").body;
+  assert.deepEqual([eur.currency, eur.total], ["EUR", "€21.00"]);
+  assert.equal(made("JPY").body.total, "¥2100");
+  assert.match(renderOrder(eur), /<p class="total">€21\.00<\/p>/);
+  assert.equal(made("GBP").status, 400);
+});
