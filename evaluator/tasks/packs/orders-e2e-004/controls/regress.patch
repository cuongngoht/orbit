diff --git a/test/invoice-durable.test.mjs b/test/invoice-durable.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..00934f26265d69887d59cc3a844ad2d53ece2164
--- /dev/null
+++ b/test/invoice-durable.test.mjs
@@ -0,0 +1,21 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { createOrder } from "../src/orders.mjs";
+import { openStore } from "../src/store.mjs";
+import { consume } from "../src/worker.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test("an acknowledged payment's invoice is found when the store is opened again right after the ack", (t) => {
+  const dir = fresh(t);
+  const order = createOrder(openStore(dir), { lines: [{ qty: 2, unitMinor: 450 }] });
+  assert.equal(consume(openStore(dir), { id: "m-7", type: "order.paid", orderId: order.id }).ack, true);
+  assert.deepEqual(openStore(dir).list("invoices").map((i) => [i.orderId, i.amountMinor]), [[order.id, 900]]);
+});
