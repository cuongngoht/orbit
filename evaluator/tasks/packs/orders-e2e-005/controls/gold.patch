diff --git a/test/redelivery.test.mjs b/test/redelivery.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b69833ebb73ec4cee55d80042925545de30aa0f5
--- /dev/null
+++ b/test/redelivery.test.mjs
@@ -0,0 +1,22 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import { createOrder } from "../src/orders.mjs";
+import { openStore } from "../src/store.mjs";
+import { consume } from "../src/worker.mjs";
+
+function fresh(t) {
+  const dir = mkdtempSync(join(tmpdir(), "orders-"));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test("a payment delivered again, even after the store is opened again, writes one invoice", (t) => {
+  const dir = fresh(t);
+  const message = { id: "m-3", type: "order.paid", orderId: createOrder(openStore(dir), { lines: [{ qty: 1, unitMinor: 250 }] }).id };
+  assert.equal(consume(openStore(dir), message).ack, true);
+  assert.equal(consume(openStore(dir), message).ack, true);
+  assert.equal(openStore(dir).list("invoices").length, 1);
+});
