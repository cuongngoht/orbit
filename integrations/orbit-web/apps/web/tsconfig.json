{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": {
      "@orbit-web/contracts": ["../../packages/contracts/src/index.ts"],
      "@orbit-web/governance-core": ["../../packages/governance-core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
