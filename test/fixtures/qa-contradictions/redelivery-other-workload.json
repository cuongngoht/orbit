                "messageId": "msg-q2b0000000000003"
              }
            }
          }
        },
        {
          "do": "call",
          "capability": "orbit.workload.control",
          "input": {
            "workloadRef": "notifier",
            "request": {
              "action": "start"
            }
          }
        },
        {
          "do": "call",
          "capability": "orbit.state.read",
          "input": {
            "stateRef": "reminders",
            "request": {
              "key": "tenant-a|inv-a|billing-daily:2026-11-02T09:00:00+07:00"
            }
          }
        }
      ]
    },
    "assertions": [
      {
        "criterionRef": "FIX-ASYNC-1/E4",
        "template": "complete",
        "step": 3
      },
      {
        "criterionRef": "FIX-ASYNC-1/E2",
        "template": "count-eq",
        "step": 5
      }
    ],
    "controls": [
      {
        "role": "duplicate",
        "why": "x"
      },
      {
        "role": "state",
        "why": "x"
      }
    ],
