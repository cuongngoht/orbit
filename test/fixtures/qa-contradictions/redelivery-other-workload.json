              "payload": {
                "messageId": "msg-q2b0000000000003",
                "businessKey": "tenant-a|inv-a|billing-daily:2026-11-02T09:00:00+07:00",
                "invoiceId": "inv-a",
                "tenantId": "tenant-a"
              }
            }
          }
        },
        {
          "do": "call",
          "capability": "orbit.worker.observe",
          "input": {
            "workloadRef": "worker",
