              "action": "fault",
              "point": "before-effect"
            }
          }
        },
        {
          "do": "call",
          "capability": "orbit.messaging.publish",
          "input": {
            "channelRef": "billing-reminder-requested",
            "request": {
              "messageId": "msg-q2b0000000000003",
