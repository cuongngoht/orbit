{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orbit.dev/schema/case.schema.json",
  "title": "UI test case (orbit)",
  "description": "One whole task driven against the live UI through playwright-cli. GENERATED by orbit from src/dsl/core/{fields,verbs}.mjs plus this project's registered extensions — edit those, then `node cli/schema.mjs --write`. Shape lives here; the rules a shape cannot express live in src/dsl/rules/.",
  "type": "object",
  "required": [
    "id",
    "name",
    "steps",
    "seen"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to the case schema, so the editor validates as you type."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Must equal the file name without .json."
    },
    "name": {
      "type": "string",
      "description": "One line a human reads in `query cases`."
    },
    "start": {
      "type": "string",
      "description": "Screen id the case begins on."
    },
    "identity": {
      "$ref": "#/definitions/identity",
      "description": "WHO the case runs as — a kind of user, never a profile name. See definitions/identity."
    },
    "identities": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/definitions/identity"
      },
      "description": "Several identities the case switches between with {\"do\":\"as\"}. Each is a separate signed-in browser."
    },
    "resolve": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/resolve"
      },
      "description": "Read-only SQL run BEFORE the browser, filling params with what it finds. No row matched means BLOCKED (exit 3), never FAIL."
    },
    "destructive": {
      "type": "boolean",
      "description": "true means the runner refuses without --force-destructive."
    },
    "creates": {
      "type": "string",
      "description": "What real object this makes in a real environment. Declaring it makes a skip-if guard mandatory."
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/param"
      },
      "description": "Values interpolated as ${NAME} anywhere in the steps."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      },
      "description": "The steps, in order."
    },
    "seen": {
      "enum": [
        "live",
        "src"
      ],
      "description": "live = every step was driven in a browser and watched. src = written from source, never run. Claim live only in the turn you finished the run."
    },
    "fe_commit": {
      "type": "string",
      "description": "The frontend commit the live run was made against — the case's only expiry date."
    },
    "note": {
      "type": "string",
      "description": "What was verified, when, against which environment — and every trap that cost someone an afternoon."
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "as": {
          "type": "string",
          "description": "Logical identity, e.g. \"admin\". Each machine maps it to a local profile in identities.json or ORBIT_IDENTITY_<AS>."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every one of these must be in the token's roles claim."
        },
        "notRoles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "None of these may be. An account that also holds the admin role passes a scoped test for the wrong reason."
        },
        "upn": {
          "type": "string",
          "description": "Pin the exact account. Usually unnecessary — roles are what authorization turns on."
        },
        "desc": {
          "type": "string",
          "description": "Why this identity, for the reader."
        }
      }
    },
    "resolve": {
      "type": "object",
      "required": [
        "as",
        "sql"
      ],
      "additionalProperties": false,
      "properties": {
        "as": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Param name this fills, usable as ${AS} in any step."
        },
        "sql": {
          "type": "string",
          "description": "A read-only SELECT. ${PARAM} is interpolated first."
        },
        "col": {
          "type": "string",
          "description": "Column to take from the first row. Default: the first column."
        },
        "desc": {
          "type": "string",
          "description": "Why this shape and not an id."
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "n"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "The name, used as ${N}."
        },
        "required": {
          "type": "boolean",
          "description": "The runner refuses without it."
        },
        "default": {
          "type": "string",
          "description": "Used when not given."
        },
        "desc": {
          "type": "string",
          "description": "What a good value looks like."
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "do"
      ],
      "additionalProperties": false,
      "properties": {
        "do": {
          "enum": [
            "goto",
            "click",
            "fill",
            "press",
            "wait",
            "assert",
            "skip-if",
            "screenshot",
            "report",
            "api",
            "sql",
            "as",
            "call"
          ],
          "description": "goto: navigate to a screen and assert the path landed. click: click the control named by `on` or `selector`. fill: type `value` into the control. press: press a key. wait: poll a predicate until true. assert: a fact that must hold now. skip-if: true means the whole case is already done — stop with SKIP. screenshot: capture the screen into the evidence directory. report: record a value; with `expect`, rule on it. api: assert the call the UI just made and its status. sql: read the database and rule on the rows. as: switch which signed-in browser the remaining steps drive. call: ask a registered capability and rule on the answer."
        },
        "on": {
          "type": "string",
          "pattern": "^[^/]+/.+$",
          "description": "\"<screen>/<via>\" — the edge whose selector (and note, and effect) this step uses. One locator defined in one place; correcting the edge fixes every case through it."
        },
        "selector": {
          "type": "string",
          "description": "Literal Playwright locator. Only where no edge can name the control — typically when the label IS the parameter — and how you test a screen the map has never seen."
        },
        "screen": {
          "type": "string",
          "description": "goto: the screen whose url to open. Elsewhere: which screen this step belongs to, for grouping the output."
        },
        "url": {
          "type": "string",
          "description": "goto: a literal path, when no screen record exists."
        },
        "value": {
          "type": "string",
          "description": "fill: the text to type."
        },
        "key": {
          "type": "string",
          "description": "press: the key, e.g. Escape, Enter."
        },
        "js": {
          "type": "string",
          "description": "wait/assert/skip-if/report: a JS expression evaluated in the page."
        },
        "file": {
          "type": "string",
          "pattern": "^[\\w.-]+\\.png$",
          "description": "screenshot: a .png file name inside the evidence directory — a name, never a path, so a case cannot write outside it."
        },
        "expect": {
          "type": "string",
          "description": "report/sql: the case's own pass/fail over the value just produced, bound to `it`. Evaluated in Node over the recorded value, not in the page."
        },
        "match": {
          "type": "string",
          "description": "api: regex matched against the request url. The LAST match wins, because the step asks about the call its own click just caused."
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "description": "api: narrow the match to one HTTP method."
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "api: the exact status required. Omit to accept any 2xx."
        },
        "query": {
          "type": "string",
          "description": "sql: a read-only SELECT. `it` is the rows; every value is a STRING because it was parsed out of text — Number(it[0].n) === 1, never it[0].n === 1."
        },
        "identity": {
          "type": "string",
          "description": "as: the identity (a key of `identities`) the remaining steps drive."
        },
        "wait": {
          "type": "string",
          "description": "A predicate polled AFTER this step — the honest alternative to a sleep. Test the thing you care about, not that the page painted."
        },
        "tries": {
          "type": "integer",
          "minimum": 1,
          "description": "Poll budget in attempts (default 25). Not a duration: one attempt is one CLI round trip, ~0.5s here and several on a loaded machine."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Poll budget in SECONDS (default 120, ORBIT_STEP_TIMEOUT). The budget that travels between machines; whichever of tries/timeout runs out first stops the poll."
        },
        "why": {
          "type": "string",
          "description": "Why this step or its wait exists. Printed next to a failure — write it for whoever debugs at 2am."
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "description": "Repeat this step and its wait N times."
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$",
          "description": "call: the namespaced capability to ask, e.g. postgres.query. Two segments at least — a bare \"query\" is a word two providers would both claim."
        },
        "input": {
          "type": "object",
          "description": "call: what to ask it, as an object the capability's own inputSchema describes. ${PARAM}s inside are filled by the capability's declared escaping, not the engine's — the capability knows which language each of its keys is read as, and the engine does not."
        },
        "select": {
          "type": "string",
          "description": "call: which part of the answer `into` binds — a dot path into the result, e.g. \"id\" or \"rows.0.id\"."
        },
        "proves": {
          "type": "string",
          "enum": [
            "ui",
            "api",
            "sql"
          ],
          "description": "call: which layer this verdict rules on — the screen (ui), the call the screen made (api), or the data underneath (sql). Every other verb names its layer in its own row; call cannot, because the same capability can be either."
        },
        "into": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "report/sql: bind the value this step produced as ${NAME}, for LATER steps to use — the id of the thing just created, say. Bound once, when the step runs, and usable only after it: that is what keeps a case a sequence of facts rather than a program. The value is written to the shared ledger, so never bind a secret."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "do": {
                "const": "goto"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "url"
              ]
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "screen"
                    ]
                  },
                  {
                    "required": [
                      "url"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "click"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "selector"
              ]
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "on"
                    ]
                  },
                  {
                    "required": [
                      "selector"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "fill"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "selector",
                "value"
              ]
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "on"
                    ]
                  },
                  {
                    "required": [
                      "selector"
                    ]
                  }
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "press"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "key"
              ]
            },
            "allOf": [
              {
                "required": [
                  "key"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "wait"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "js"
              ]
            },
            "allOf": [
              {
                "required": [
                  "js"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "assert"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "js"
              ]
            },
            "allOf": [
              {
                "required": [
                  "js"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "skip-if"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "js"
              ]
            },
            "allOf": [
              {
                "required": [
                  "js"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "screenshot"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "file"
              ]
            },
            "allOf": [
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "report"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "js",
                "expect",
                "into"
              ]
            },
            "allOf": [
              {
                "required": [
                  "js"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "api"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "match",
                "method",
                "status"
              ]
            },
            "allOf": [
              {
                "required": [
                  "match"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "sql"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "query",
                "expect",
                "into"
              ]
            },
            "allOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "expect"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "as"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "identity"
              ]
            },
            "allOf": [
              {
                "required": [
                  "identity"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "do": {
                "const": "call"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "do",
                "on",
                "screen",
                "wait",
                "tries",
                "timeout",
                "why",
                "times",
                "capability",
                "input",
                "expect",
                "select",
                "into",
                "proves"
              ]
            },
            "allOf": [
              {
                "required": [
                  "capability"
                ]
              },
              {
                "required": [
                  "expect"
                ]
              },
              {
                "required": [
                  "proves"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
